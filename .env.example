# Organization name shown in the app
NEXT_PUBLIC_ORG_NAME="Your Company"

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://cecs_user:cecs_password@localhost:5432/cecs?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# MinIO Object Storage (S3-compatible)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="cecs-attachments"

# External Scheduler / Cron Job Protection
CRON_SECRET="cecs-cron-secret-token-change-in-prod"
