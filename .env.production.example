# =============================================
# CECS Production Environment
# Salin ke .env.production dan isi semua password
# =============================================

# ---- Branding (applied at build time) ----
NEXT_PUBLIC_ORG_NAME="Your Company"

# ---- PostgreSQL ----
POSTGRES_DB=cecs
POSTGRES_USER=cecs_user
POSTGRES_PASSWORD=CHANGE_ME

# ---- Auth ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# Alamat yang dibuka pengguna
NEXTAUTH_URL=https://cecs.example.com

# IP LAN server (opsional, untuk QR Code di jaringan lokal)
LAN_IP=

# ---- MinIO ----
MINIO_ACCESS_KEY=cecsadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=cecs-attachments

# ---- Cron ----
CRON_SECRET=CHANGE_ME

# ---- Cloudflare Tunnel (opsional, lihat docs/CLOUDFLARE-TUNNEL.md) ----
# Token dari dashboard Cloudflare Zero Trust saat membuat tunnel.
# Hanya dipakai bila dijalankan dengan --profile tunnel.
CF_TUNNEL_TOKEN=

# Bind address untuk Nginx.
#   0.0.0.0   = port 80/443 terbuka (mode port-forward)
#   127.0.0.1 = tertutup dari jaringan, hanya cloudflared yang bisa akses
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# ---- Pembatasan IP untuk ADMIN & SUPERVISOR ----
# Akun ADMIN dan SUPERVISOR hanya bisa dipakai dari jaringan di bawah ini.
# OPERATOR dan TECHNICIAN tidak terpengaruh — mereka tetap bisa scan QR
# dari mana saja.
#
# Kosongkan untuk MENONAKTIFKAN fitur ini.
# Pisahkan dengan koma. Mendukung CIDR IPv4 dan alamat tunggal.
#
# JANGAN menulis 172.16.0.0/12 di sini kecuali kamu benar-benar paham
# akibatnya: itu rentang bridge Docker, dan memasukkannya akan membuat
# SEMUA lalu lintas dari internet tampak "lokal" bila reverse proxy tidak
# meneruskan IP asli. Lihat docs/IP-RESTRICTION.md
ADMIN_IP_ALLOWLIST=

# ---- Bind address aplikasi ----
#   127.0.0.1 = hanya dari host itu sendiri, untuk reverse proxy di host
#   0.0.0.0   = dapat dijangkau dari seluruh LAN
APP_BIND=127.0.0.1
